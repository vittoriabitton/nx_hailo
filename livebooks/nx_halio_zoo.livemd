# NxHailo Zoo

## Setup

```elixir
defmodule Livebook.ImageLoader do

  def evision_resize_and_pad(image, {h, w}, {target_size, target_size}) do
    size = max(h, w)
    pad_h = div(size - h, 2)
    pad_w = div(size - w, 2)

    padded =
      Evision.copyMakeBorder(
        image,
        pad_h,
        pad_h + rem(size - h, 2),
        pad_w,
        pad_w + rem(size - w, 2),
        Evision.Constant.cv_BORDER_CONSTANT(),
        value: {114, 114, 114}
      )

    Evision.resize(padded, {target_size, target_size})
  end
  
  def load_and_size_image(image_path, model) do
    input_image = Evision.imread(image_path)

    {frame_h, frame_w, _} = Evision.Mat.shape(input_image)

    input_shape = {frame_h, frame_w}
  
    padded_image = evision_resize_and_pad(input_image, input_shape, model.shape)
    padded_image
  end
end
```

```elixir
defmodule HailoLivebook.Model do
  defstruct [model: nil, 
    classes: [], 
    name: "",
    output_key: nil, 
    shape: nil, 
    quant_info: nil, 
    format: nil,
  parser: nil]
end

defmodule HailoLivebook.Loader do
  def load_model(model_name, shape, class_file, parser) do
    {:ok, hailo_resnet_model} = NxHailo.load(model_name)

    [%{name: resnet_name}] = hailo_resnet_model.pipeline.input_vstream_infos
    [%{name: resnet_output_key, quant_info: quant_info, format: format}] = hailo_resnet_model.pipeline.output_vstream_infos

        resnet_classes =
          class_file
      |> File.read!()
      |> Jason.decode!()
      |> Enum.with_index()
      |> Map.new(fn {v, k} -> {k, v} end)
    
    
    %HailoLivebook.Model{model: hailo_resnet_model,
      classes: resnet_classes, 
      name: resnet_name,
      output_key: resnet_output_key,
      shape: shape,
      quant_info: quant_info,
      format: format,
      parser: parser
      }
  end

  def transfer_and_infer(image, model) do
    {h, w} = model.shape
    new_shape = {h, w, 3}
    input_tensor =
    image
    |> Evision.Mat.to_nx()
    |> Nx.reshape(new_shape)
    |> Nx.backend_transfer()

  {:ok, raw_objects} =
    NxHailo.infer(
      model.model,
      %{model.name => input_tensor},
      model.parser,
      classes: model.classes,
      key: model.output_key
    ) 
    
    {:ok, raw_objects}
  end
end

```

This notebook runs inference on a Hailo device via Livebook's **Attached Node** runtime. The node must be running on the device before connecting.

**Start the node on the device:**

```shell
./scripts/start_node.exs
```

Then in Livebook go to **Runtime → Attached Node** and enter the node name and cookie printed by the script.

> See `livebooks/download_models.livemd` to download a `.hef` model file before running inference.

